# flai configuration

# Application environment: development, local, test, staging, production
APP_ENV=development

# Server Port
PORT=8080

# Database driver: sqlite, postgres, or mysql
DB_DRIVER=sqlite

# SQLite database path (used when DB_DRIVER=sqlite, or as the source for --migrate)
DB_PATH=flai.db

# PostgreSQL/MySQL connection string (used when DB_DRIVER is postgres or mysql).
# `go run . --migrate` copies DB_PATH to this empty target database selected by DB_DRIVER.
# DB_DSN=host=127.0.0.1 user=flai password=change-me dbname=flai port=5432 sslmode=disable
# DB_DSN=flai:change-me@tcp(127.0.0.1:3306)/flai?charset=utf8mb4&parseTime=True&loc=Local
# DATABASE_URL is also supported as a fallback for DB_DSN.
DB_DSN=

# PostgreSQL/MySQL connection pool settings (SQLite always uses one connection)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=3600

# Node identity. Required on every instance once multi-node mode is enabled in
# system settings: the first node to register becomes the primary and owns the
# scheduled background work, later nodes join as replicas. A single-node
# deployment can leave this empty.
# NODE_NAME=node-a

# Optional Redis cache connection. Redis is disabled unless REDIS_ENABLED=true
# or the Redis system setting is enabled. REDIS_URL takes precedence over the
# individual REDIS_* connection values below.
# REDIS_ENABLED=true
# REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# REDIS_ADDR=127.0.0.1:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false

# JWT Secret for dashboard sessions
JWT_SECRET=your-secure-jwt-secret-here

# OIDC Configuration
OIDC_ISSUER=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback

# Optional: users matching these OIDC subjects or emails become admins on login
BOOTSTRAP_ADMIN_OIDC_SUBS=
BOOTSTRAP_ADMIN_EMAILS=
